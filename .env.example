DATABASE_URL=postgresql://localhost:5432/mylittlepier
# Gere um segredo exclusivo com openssl rand -hex 32.
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_DAYS=60
GOOGLE_PLAY_GAMES_CLIENT_ID=
GOOGLE_PLAY_GAMES_CLIENT_SECRET=
APPLE_GAMECENTER_BUNDLE_ID=com.fishia.mylittlepier
PORT=3000
CORS_ORIGINS=

# Credenciais exclusivas do My Little Pier. Use o gerenciador de segredos do ambiente.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_APP_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.kumagames.mylittlepier
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_PUSH_SERVICE_ACCOUNT=
IAP_CREDIT_SANDBOX=false
# IDs numéricos enviados no campo ad_unit do AdMob, separados por vírgula.
ADMOB_REWARDED_AD_UNITS=

# Gerado no ambiente de hospedagem para GET /jobs/bait.
CRON_SECRET=
