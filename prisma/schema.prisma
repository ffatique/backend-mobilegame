generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProviderType {
  GOOGLE_PLAY
  APPLE_GAMECENTER
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  provider       AuthProviderType
  providerUserId String           @db.VarChar(256)
  name           String           @db.VarChar(32)
  coins          Int              @default(0)
  createdAt      DateTime         @default(now())
  refreshTokens  RefreshToken[]
  purchases      Purchase[]
  gems           Int              @default(0)
  adRewardGrants AdRewardGrant[]
  iapPurchases   IapPurchase[]

  @@unique([provider, providerUserId])
  @@map("players")
}

model Purchase {
  userId    String   @db.Uuid
  itemId    String   @db.VarChar(64)
  pricePaid Int
  boughtAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("purchases")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(64) // hex sha-256
  deviceId     String?   @db.Uuid
  userAgent    String?   @db.VarChar(255)
  ipHash       String?   @db.VarChar(64)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum IapPlatform {
  APPLE
  GOOGLE
}

enum IapEnvironment {
  PRODUCTION
  SANDBOX
}

enum IapPurchaseStatus {
  GRANTED
  REFUNDED
}

model AdRewardGrant {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  transactionId String   @unique @db.VarChar(64)
  adUnit        String?  @db.VarChar(64)
  adNetwork     String?  @db.VarChar(64)
  rewardItem    String?  @db.VarChar(32)
  /// Reward amount reported (and signed) by AdMob. Recorded for auditing; the
  /// coins actually credited are the server-authoritative `coinsGranted`.
  rewardAmount  Int
  coinsGranted  Int
  /// When AdMob rewarded the user (from the callback `timestamp`).
  rewardedAt    DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ad_reward_grants")
}

model GemPackDefinition {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @db.VarChar(128)
  platform  IapPlatform
  gems      Int
  isEnabled Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([platform, productId])
  @@map("gem_pack_definitions")
}

model IapPurchase {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String?           @db.Uuid
  platform           IapPlatform
  environment        IapEnvironment?
  productId          String?           @db.VarChar(128)
  storeTransactionId String            @db.Text
  orderId            String?           @db.VarChar(128)
  gemsGranted        Int
  status             IapPurchaseStatus @default(GRANTED)
  purchasedAt        DateTime?
  lastAdjustmentAt   DateTime?
  refundedAt         DateTime?
  rawPayload         Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([platform, storeTransactionId])
  @@index([userId, createdAt])
  @@map("iap_purchases")
}
