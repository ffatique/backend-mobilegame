generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProviderType {
  GOOGLE_PLAY
  APPLE_GAMECENTER
}

model User {
  id             String            @id @default(uuid()) @db.Uuid
  provider       AuthProviderType
  providerUserId String            @db.VarChar(256)
  name           String            @db.VarChar(32)
  coins          Int               @default(0)
  createdAt      DateTime          @default(now())
  avatar         String?
  swimmers       PierSwimmer[]
  attempts       PierAttempt[]
  baitOperations BaitOperation[]
  activityDays   PierActivityDay[]
  pierSave       PierSave?
  catches        PierCatch[]
  firstFriends   Friendship[]      @relation("first")
  secondFriends  Friendship[]      @relation("second")
  refreshTokens  RefreshToken[]
  purchases      Purchase[]
  gems           Int               @default(0)
  adRewardGrants AdRewardGrant[]
  iapPurchases   IapPurchase[]

  @@unique([provider, providerUserId])
  @@map("players")
}

model Purchase {
  userId    String   @db.Uuid
  itemId    String   @db.VarChar(64)
  pricePaid Int
  boughtAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("purchases")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(64) // hex sha-256
  deviceId     String?   @db.Uuid
  userAgent    String?   @db.VarChar(255)
  ipHash       String?   @db.VarChar(64)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum IapPlatform {
  APPLE
  GOOGLE
}

enum IapEnvironment {
  PRODUCTION
  SANDBOX
}

enum IapPurchaseStatus {
  GRANTED
  REFUNDED
}

model AdRewardGrant {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  transactionId String   @unique @db.VarChar(64)
  adUnit        String?  @db.VarChar(64)
  adNetwork     String?  @db.VarChar(64)
  rewardItem    String?  @db.VarChar(32)
  /// Reward amount reported (and signed) by AdMob. Recorded for auditing; the
  /// coins actually credited are the server-authoritative `coinsGranted`.
  rewardAmount  Int
  coinsGranted  Int
  /// When AdMob rewarded the user (from the callback `timestamp`).
  rewardedAt    DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ad_reward_grants")
}

model GemPackDefinition {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @db.VarChar(128)
  platform  IapPlatform
  gems      Int
  isEnabled Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([platform, productId])
  @@map("gem_pack_definitions")
}

model IapPurchase {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String?           @db.Uuid
  platform           IapPlatform
  environment        IapEnvironment?
  productId          String?           @db.VarChar(128)
  storeTransactionId String            @db.Text
  orderId            String?           @db.VarChar(128)
  gemsGranted        Int
  status             IapPurchaseStatus @default(GRANTED)
  purchasedAt        DateTime?
  lastAdjustmentAt   DateTime?
  refundedAt         DateTime?
  rawPayload         Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([platform, storeTransactionId])
  @@index([userId, createdAt])
  @@map("iap_purchases")
}

model PierActivityDay {
  playerId String   @db.Uuid
  day      DateTime @db.Date
  player   User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, day])
  @@map("pier_activity_days")
}

model PierSave {
  owned     String[] @default([])
  outfit    String?
  hat       String?
  playerId  String   @id @db.Uuid
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  snapshot  String   @default("") @db.Text
  revision  Int      @default(0)
  mutation  String?  @db.Uuid
  bonusBait Int      @default(0)
  bait      Int      @default(12)
  day       DateTime @default(dbgenerated("(now() AT TIME ZONE 'UTC')::date")) @db.Date

  @@index([day])
  @@map("pier_saves")
}

model Friendship {
  low      String  @db.Uuid
  high     String  @db.Uuid
  sender   String  @db.Uuid
  accepted Boolean @default(false)
  first    User    @relation("first", fields: [low], references: [id], onDelete: Cascade)
  second   User    @relation("second", fields: [high], references: [id], onDelete: Cascade)

  @@id([low, high])
  @@index([high])
  @@map("friendships")
}

model PierCatch {
  playerId String   @db.Uuid
  revision Int
  species  Int
  rare     Boolean
  length   Int
  grams    Int
  size     String   @db.VarChar(2)
  caughtAt DateTime @default(now())
  player   User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, revision])
  @@map("pier_catches")
}

model BaitOperation {
  id            String   @id @db.Uuid
  playerId      String?  @db.Uuid
  installation  String?  @db.Char(64)
  session       String?  @db.Uuid
  player        User?    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kind          String
  day           DateTime @db.Date
  milestone     Int?
  transactionId String?  @unique

  @@unique([playerId, milestone])
  @@unique([installation, session, milestone])
  @@index([installation, day], map: "bait_operations_guest_quota")
  @@index([playerId, day, kind], map: "bait_operations_quota")
  @@map("bait_operations")
}

model PierSwimmer {
  id         String  @id @db.Uuid
  playerId   String  @db.Uuid
  player     User    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  station    Int
  species    Int
  slot       Int
  rare       Boolean
  percentile Int
  length     Int
  grams      Int

  @@unique([playerId, station, species, slot])
  @@map("pier_schools")
}

model PierAttempt {
  playerId      String    @db.Uuid
  player        User      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  id            String    @db.Uuid
  station       Int
  fishId        String?   @db.Uuid
  species       Int?
  rare          Boolean?
  percentile    Int?
  length        Int?
  grams         Int?
  openedAt      DateTime  @default(now()) @db.Timestamptz(6)
  closedAt      DateTime? @db.Timestamptz(6)
  outcome       String?
  finishKey     String?   @db.Uuid
  passAvailable Boolean
  newRecord     Boolean   @default(false)

  @@id([playerId, id])
  @@map("pier_attempts")
}

model PierRefill {
  id         BigInt   @id @default(autoincrement())
  ranAt      DateTime @default(now()) @map("ran_at") @db.Timestamptz(6)
  accounts   Int
  durationMs Int      @map("duration_ms")

  @@map("pier_refills")
}
